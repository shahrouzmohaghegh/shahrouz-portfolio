# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planning and tooling (never public)
/docs/
/.claude/
/_bmad/

# _bmad-output: allow-list. Ignore everything, then re-include only the
# five approved planning files. Git cannot re-include a file whose parent
# directory is excluded, so each directory on the path is re-included and
# its contents re-ignored.
/_bmad-output/*
!/_bmad-output/planning-artifacts/
/_bmad-output/planning-artifacts/*
!/_bmad-output/planning-artifacts/briefs/
/_bmad-output/planning-artifacts/briefs/*
!/_bmad-output/planning-artifacts/briefs/brief-ShahrouzPortfolio-2026-09-23/
/_bmad-output/planning-artifacts/briefs/brief-ShahrouzPortfolio-2026-09-23/*
!/_bmad-output/planning-artifacts/briefs/brief-ShahrouzPortfolio-2026-09-23/brief.md
!/_bmad-output/planning-artifacts/ux-designs/
/_bmad-output/planning-artifacts/ux-designs/*
!/_bmad-output/planning-artifacts/ux-designs/ux-ShahrouzPortfolio-2026-09-23/
/_bmad-output/planning-artifacts/ux-designs/ux-ShahrouzPortfolio-2026-09-23/*
!/_bmad-output/planning-artifacts/ux-designs/ux-ShahrouzPortfolio-2026-09-23/DESIGN.md
!/_bmad-output/planning-artifacts/ux-designs/ux-ShahrouzPortfolio-2026-09-23/EXPERIENCE.md
!/_bmad-output/planning-artifacts/architecture/
/_bmad-output/planning-artifacts/architecture/*
!/_bmad-output/planning-artifacts/architecture/architecture-ShahrouzPortfolio-2026-09-25/
/_bmad-output/planning-artifacts/architecture/architecture-ShahrouzPortfolio-2026-09-25/*
!/_bmad-output/planning-artifacts/architecture/architecture-ShahrouzPortfolio-2026-09-25/ARCHITECTURE-SPINE.md
!/_bmad-output/planning-artifacts/architecture/architecture-ShahrouzPortfolio-2026-09-25/C4-ARCHITECTURE.md

# Planning files that must never be published. The allow-list above
# already excludes them; they are listed by name so they stay excluded if
# the allow-list is ever loosened. Kept last so no re-include can override them.
/_bmad-output/planning-artifacts/briefs/**/addendum.md
/_bmad-output/planning-artifacts/prds/
/_bmad-output/planning-artifacts/epics.md
/_bmad-output/implementation-artifacts/
/_bmad-output/**/reviews/
/_bmad-output/**/reconcile-*.md
/_bmad-output/**/review-*.md
/_bmad-output/**/.memlog.md
/_bmad-output/**/sprint-change-proposal-*.md

# Local list of confidential terms read by scripts/check-repo.mjs
/.forbidden-terms

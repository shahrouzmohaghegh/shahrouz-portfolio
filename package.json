    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }

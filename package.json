{
  "name": "shahrouz-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-tokens.mts",
    "check:readme": "node scripts/check-readme.mts",
    "check:content-review": "node scripts/check-content-review.mts",
    "check:links": "node scripts/check-links.mts",
    "test:scripts": "node --test \"scripts/**/*.test.mts\"",
    "test": "vitest run",
    "terms:sync": "node scripts/terms-sync.mts",
    "watch:production": "node scripts/production-watch.mts --print"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
